# Copy to .env for local runs (never commit .env). In GitHub Actions these
# are set as repo Secrets instead (Settings > Secrets and variables > Actions).
#
# No email config here - the sync summary (newly matched / unmatched shorts)
# is written to the GitHub Actions run summary instead (see src/summary.js).

# --- Required ---
YOUTUBE_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Optional: defaults to @isogreenromania if unset ---
CHANNEL_HANDLE=

# --- Optional: omit both to skip Facebook + Instagram ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Optional: omit both to skip TikTok ---
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=

# --- Optional Notion databases (each skipped if unset) ---
CHANNEL_STATS_DATABASE_ID=
MONTHLY_VIEWS_DATABASE_ID=
# Real per-day view totals (not monthly) - powers the dashboard's custom
# date-range "Total views" KPI. Create via `npm run backfill:create-daily-views-db`
# (one-time), then set this to the ID it prints, and run
# `npm run backfill:daily-views` once to backfill full history.
DAILY_VIEWS_DATABASE_ID=
# One row per platform per day of follower/subscriber counts. No historical
# API exists for this on any platform, so there's no backfill - it only
# starts capturing from whenever this database first exists. Create via
# `npm run backfill:create-follower-snapshots-db`, then set this to the ID
# it prints.
FOLLOWER_SNAPSHOTS_DATABASE_ID=

# --- Optional: YouTube Analytics (real monthly channel views) - omit any to skip ---
# One-time setup: fill in the client ID/secret below (from the Google Cloud
# "Web application" OAuth client, redirect URI http://localhost:8080/), then
# run `node --env-file=.env scripts/youtube-oauth-setup.js` locally to mint
# YOUTUBE_REFRESH_TOKEN. Never commit the refresh token.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Video analysis pipeline (Gemini extract -> Claude score -> Notion) ---
# One-time setup: run `node --env-file=.env scripts/backfill-create-video-analysis-db.js`
# to create the "Video Analysis" database, then set VIDEO_ANALYSIS_DATABASE_ID
# to the ID it prints. Run the pipeline with `npm run analyze:videos`.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VIDEO_ANALYSIS_DATABASE_ID=
# Which Video DB property holds the actual video file (Files & media
# property, or a URL property if hosted elsewhere) - required.
VIDEO_FILE_FIELD_NAME=Video File
# Which Video DB properties (if any) hold per-video performance numbers -
# used as scoring context and by the A/B validation script. Leave the
# defaults if those properties don't exist yet; they're read as optional.
VIEWS_FIELD_NAME=Views
RETENTION_FIELD_NAME=Retention
COMMENTS_FIELD_NAME=Comments
# One paragraph of brand context handed to the Claude scoring step.
BRAND_CONTEXT=
# v1-gemini-only | v2-gemini-claude - tags every written row so the two
# pipelines can run side by side on the same videos without overwriting
# each other (see scripts/backfill-create-video-analysis-db.js).
PIPELINE_VERSION=v2-gemini-claude

# Deploy happens by publishing dist/clients/ to a small public output repo
# (.github/workflows/sync.yml), which a cPanel cron job on SiteBunker pulls
# from directly - not from this script. DASHBOARD_REPO_PAT (a GitHub Actions
# secret, no local .env equivalent) is the only credential involved; a local
# `npm run sync` never deploys anywhere, it just writes dist/clients/ to disk.
