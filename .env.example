# Copy to .env for local runs (never commit .env). In GitHub Actions these
# are set as repo Secrets instead (Settings > Secrets and variables > Actions).
#
# No email config here - the sync summary (newly matched / unmatched shorts)
# is written to the GitHub Actions run summary instead (see src/summary.js).

# --- Required ---
YOUTUBE_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Optional: defaults to @isogreenromania if unset ---
CHANNEL_HANDLE=

# --- Optional: omit both to skip Facebook + Instagram ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Optional: omit both to skip TikTok ---
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=

# --- Optional Notion databases (each skipped if unset) ---
CHANNEL_STATS_DATABASE_ID=
MONTHLY_VIEWS_DATABASE_ID=
TIKTOK_SNAPSHOT_DATABASE_ID=

# --- FTP deploy (SiteBunker) ---
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
# Path on the FTP server that corresponds to /clients/isogreen/ under the site's web root
FTP_SERVER_DIR=
