{
  "$id": "videoAnalysisScoring",
  "title": "Video Analysis - Stage 2 scoring (Claude)",
  "description": "Rating + reasoning derived from a Stage 1 raw extraction plus performance context. Every score must be grounded in evidence_timestamps that trace back to something Gemini actually observed.",
  "type": "object",
  "required": ["video_id", "scores", "overall_notes"],
  "properties": {
    "video_id": { "type": "string" },
    "scores": {
      "type": "object",
      "required": ["hook", "structure", "format", "pacing", "cta"],
      "properties": {
        "hook": { "$ref": "#/$defs/scoreCategory" },
        "structure": { "$ref": "#/$defs/scoreCategory" },
        "format": { "$ref": "#/$defs/scoreCategory" },
        "pacing": { "$ref": "#/$defs/scoreCategory" },
        "cta": { "$ref": "#/$defs/scoreCategory" }
      }
    },
    "overall_notes": { "type": "string" },
    "reusable_pattern": { "type": "string", "description": "One sentence describing a technique from this video that could be reused elsewhere, if any" }
  },
  "$defs": {
    "scoreCategory": {
      "type": "object",
      "required": ["score", "reasoning", "evidence_timestamps"],
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 10 },
        "reasoning": { "type": "string" },
        "evidence_timestamps": { "type": "array", "items": { "type": "number" } }
      }
    }
  }
}
